// Cloudflare Workers(정적 자산) 배포 설정 — 빌드 결과물 out/ 을 그대로 서빙
{
  "name": "customy-homepage",
  "compatibility_date": "2025-09-01",
  // 공개 주소(<name>.<계정>.workers.dev)와 브랜치별 미리보기 주소 켜기
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
